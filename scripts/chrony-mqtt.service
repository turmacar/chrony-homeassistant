[Unit]
Description=Publish chrony tracking/sources status to MQTT
After=network-online.target chronyd.service
Wants=network-online.target
Requires=chronyd.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/chrony-mqtt
ExecStart=/usr/local/bin/chrony-mqtt.sh
Restart=on-failure
RestartSec=5s
