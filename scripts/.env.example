# Copy this file to /etc/default/chrony-mqtt (used by systemd, see
# chrony-mqtt.service) or to scripts/.env (used for manual/interactive runs).
# Never commit the real file -- it is gitignored.

MQTT_HOST=your-mqtt-broker
MQTT_PORT=1883
MQTT_USER=your-mqtt-username
MQTT_PASS=your-mqtt-password

# Optional, defaults to 30
INTERVAL=30
